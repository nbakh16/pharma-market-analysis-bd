table master_medicines_enriched
	lineageTag: b69aa320-a78d-4e0f-ab47-faa7e8a9e7a4

	measure 'Median Unit Price' =
			
			CALCULATE(
			    MEDIAN('master_medicines_enriched'[price_bdt]),
			    'master_medicines_enriched'[pricing_basis] = "per_unit"
			)
		lineageTag: 258c6bc6-b94b-44d0-857c-2105b609aa7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Crowded Brands' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('master_medicines_enriched'[brand_id]),
			        'master_medicines_enriched'[competition_tier] = "4. Crowded (11+ Mfgs)"
			    ),
			    DISTINCTCOUNT('master_medicines_enriched'[brand_id]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d47af1b3-28b5-4fc9-a7c7-9961b749178b

	measure 'Below Median %' =
			
			VAR BelowCount = CALCULATE(DISTINCTCOUNT('master_medicines_enriched'[brand_id]), 'master_medicines_enriched'[pricing_stance] = "Below Median (<0.99x)")
			VAR ValidCount = CALCULATE(DISTINCTCOUNT('master_medicines_enriched'[brand_id]), 'master_medicines_enriched'[pricing_stance] <> "Not Applicable (Non-Unit / <10 Brands)")
			RETURN DIVIDE(BelowCount, ValidCount, 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2818bba4-0904-42ff-b40f-5065e63c90ee

	measure 'At Median %' =
			
			VAR AtCount = CALCULATE(DISTINCTCOUNT('master_medicines_enriched'[brand_id]), 'master_medicines_enriched'[pricing_stance] = "At Market Median (1.00x)")
			VAR ValidCount = CALCULATE(DISTINCTCOUNT('master_medicines_enriched'[brand_id]), 'master_medicines_enriched'[pricing_stance] <> "Not Applicable (Non-Unit / <10 Brands)")
			RETURN DIVIDE(AtCount, ValidCount, 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fe12b9b0-e07a-4736-bd7c-a033b2f9aaf0

	measure 'Above Median %' =
			
			VAR AboveCount = CALCULATE(DISTINCTCOUNT('master_medicines_enriched'[brand_id]), 'master_medicines_enriched'[pricing_stance] = "Above Median (>1.01x)")
			VAR ValidCount = CALCULATE(DISTINCTCOUNT('master_medicines_enriched'[brand_id]), 'master_medicines_enriched'[pricing_stance] <> "Not Applicable (Non-Unit / <10 Brands)")
			RETURN DIVIDE(AboveCount, ValidCount, 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 879524ea-49f2-4c02-840b-61031125494b

	measure '% Monopoly Generics' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('master_medicines_enriched'[generic_id]),
			        'master_medicines_enriched'[competition_tier] = "1. Monopoly (1 Mfg)"
			    ),
			    DISTINCTCOUNT('master_medicines_enriched'[generic_id]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 239ff6e5-b921-4a5f-ad6a-95292d4b8485

